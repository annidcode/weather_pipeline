x), 2) AS avg_wind,\n    ROUND(MAX(wind_gusts_max), 2) AS max_gust\nFROM `weather_staging`.`stg_openmeteo_history`\nGROUP BY city, latitude, longitude\nORDER BY avg_temp DESC", "relation_name": "`weather_marts`.`city_summary`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-10T14:50:44.974886Z", "completed_at": "2026-10-10T14:50:45.018957Z"}, {"name": "execute", "started_at": "2026-10-10T14:50:45.025989Z", "completed_at": "2026-10-10T14:50:45.144281Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.17348718643188477, "adapter_response": {"_message": "OK", "query_id": "2d4aa4de-a054-4d51-b14f-465ba2efe983"}, "message": "OK", "failures": null, "unique_id": "model.weather_pipeline.region_summary", "compiled": true, "compiled_code": "\n\nSELECT\n    region,\n    COUNT(*) AS rows_count,\n    COUNT(DISTINCT city) AS cities_count,\n    ROUND(AVG(temp_mean), 2) AS avg_temp,\n    ROUND(MIN(temp_min), 2) AS min_temp,\n    ROUND(MAX(temp_max), 2) AS max_temp,\n    ROUND(SUM(precipitation), 2) AS total_precipitation,\n    ROUND(MAX(wind_gusts_max), 2) AS max_gust\nFROM `weather_staging`.`stg_openmeteo_history`\nGROUP BY region\nORDER BY avg_temp DESC", "relation_name": "`weather_marts`.`region_summary`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-10T14:50:44.976265Z", "completed_at": "2026-10-10T14:50:45.025698Z"}, {"name": "execute", "started_at": "2026-10-10T14:50:45.042327Z", "completed_at": "2026-10-10T14:50:45.145162Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.17412114143371582, "adapter_response": {"_message": "OK", "query_id": "9288aa8d-4b3b-4481-894c-a0eb4cd0c7e5"}, "message": "OK", "failures": null, "unique_id": "model.weather_pipeline.weather_anomalies", "compiled": true, "compiled_code": "\n\nWITH stats AS (\n    SELECT\n        city,\n        AVG(temp_mean) AS avg_temp,\n        stddevPop(temp_mean) AS std_temp\n    FROM `weather_staging`.`stg_openmeteo_history`\n    GROUP BY city\n)\n\nSELECT\n    w.city,\n    w.date,\n    w.temp_mean,\n    s.avg_temp,\n    s.std_temp,\n    ROUND((w.temp_mean - s.avg_temp) / NULLIF(s.std_temp, 0), 2) AS z_score,\n    CASE\n        WHEN ABS((w.temp_mean - s.avg_temp) / NULLIF(s.std_temp, 0)) > 2 THEN 'anomaly'\n        WHEN ABS((w.temp_mean - s.avg_temp) / NULLIF(s.std_temp, 0)) > 1.5 THEN 'warning'\n        ELSE 'normal'\n    END AS flag\nFROM `weather_staging`.`stg_openmeteo_history` w\nJOIN stats s ON w.city = s.city\nWHERE ABS((w.temp_mean - s.avg_temp) / NULLIF(s.std_temp, 0)) > 1.5\nORDER BY z_score DESC", "relation_name": "`weather_marts`.`weather_anomalies`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-10T14:50:44.973545Z", "completed_at": "2026-10-10T14:50:45.007887Z"}, {"name": "execute", "started_at": "2026-10-10T14:50:45.013398Z", "completed_at": "2026-10-10T14:50:45.197670Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.2273550033569336, "adapter_response": {"_message": "OK", "query_id": "4973f1e7-3cf2-4009-acfd-f23fc68dbf1c"}, "message": "OK", "failures": null, "unique_id": "model.weather_pipeline.daily_weather", "compiled": true, "compiled_code": "\n\nSELECT\n    city,\n    date,\n    temp_max,\n    temp_min,\n    temp_mean,\n    precipitation,\n    wind_speed_max,\n    wind_gusts_max,\n    -- \u0421\u043a\u043e\u043b\u044c\u0437\u044f\u0449\u0435\u0435 \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u0437\u0430 7 \u0434\u043d\u0435\u0439\n    AVG(temp_mean) OVER (\n        PARTITION BY city\n        ORDER BY date\n        ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n    ) AS temp_mean_7d,\n    -- \u041e\u0442\u043a\u043b\u043e\u043d\u0435\u043d\u0438\u0435 \u043e\u0442 \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u0437\u0430 30 \u0434\u043d\u0435\u0439\n    temp_mean - AVG(temp_mean) OVER (\n        PARTITION BY city\n        ORDER BY date\n        ROWS BETWEEN 29 PRECEDING AND CURRENT ROW\n    ) AS temp_anomaly\nFROM `weather_staging`.`stg_openmeteo_history`", "relation_name": "`weather_marts`.`daily_weather`", "batch_results": null, "overload_results": null}], "elapsed_time": 0.5543320178985596, "args": {"show_resource_report": false, "require_generic_test_arguments_property": true, "introspect": true, "defer": false, "use_v2_parser": false, "strict_mode": false, "log_file_max_bytes": 10485760, "favor_state": false, "partial_parse_file_diff": true, "printer_width": 80, "require_valid_schema_from_generate_schema_name": false, "upload_to_artifacts_ingest_api": false, "log_format_file": "debug", "state_modified_compare_vars": false, "log_path": "/Users/A/projects/weather_pipeline/dbt/logs", "warn_error_options": {"error": [], "warn": [], "silence": []}, "v2_parser": "dbt-core-experimental-parser parse", "maximum_seed_size_mib": 1, "source_freshness_run_project_hooks": true, "indirect_selection": "eager", "partial_parse": true, "profiles_dir": "/Users/A/projects/weather_pipeline/dbt", "vars": {}, "require_yaml_configuration_for_mf_time_spines": true, "version_check": true, "hints_enabled": true, "write_json": true, "skip_nodes_if_on_run_start_fails": true, "require_ref_searches_node_package_before_root": false, "snowflake_projects_otel": false, "exclude": [], "require_source_and_semantic_model_names_without_spaces": false, "allow_jinja_file_extensions": false, "macro_debugging": false, "log_level_file": "debug", "populate_cache": true, "use_catalogs_v2": false, "support_custom_ref_kwargs": false, "latest_version_pointer_enabled_by_default": false, "require_resource_names_without_spaces": true, "state_modified_compare_more_unrendered_values": true, "use_fast_test_edges": false, "use_colors": true, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "empty": false, "invocation_command": "dbt run", "require_unique_project_resource_names": false, "requir